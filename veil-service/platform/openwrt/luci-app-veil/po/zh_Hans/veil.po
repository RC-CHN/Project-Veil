msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"

msgid "Access"
msgstr "访问范围"

msgid "Add a connection to choose a server and open local proxy listeners."
msgstr "添加连接，选择服务器并开启本地代理入口。"

msgid "Add connection"
msgstr "添加连接"

msgid "Add listener"
msgstr "添加入口"

msgid "Add relay"
msgstr "添加中转"

msgid "Advanced JSON"
msgstr "高级 JSON 设置"

msgid "Advanced settings contain credentials. Form fields override matching JSON values."
msgstr "高级设置包含认证信息，表单字段会覆盖 JSON 中对应的值。"

msgid "Apply changes"
msgstr "应用更改"

msgid "Applying connection changes may interrupt its active streams. Other connections keep running."
msgstr "应用更改可能中断此连接的现有流量，其他连接继续运行。"

msgid "Applying relay changes may reconnect connections using it."
msgstr "应用中转更改可能使使用它的连接重新连接。"

msgid "Authentication secret"
msgstr "认证密钥"

msgid "CA certificate path"
msgstr "CA 证书路径"

msgid "Cancel"
msgstr "取消"

msgid "Configuration must be smaller than 64 KiB."
msgstr "配置必须小于 64 KiB。"

msgid "Connect through"
msgstr "连接方式"

msgid "Connection path"
msgstr "连接路径"

msgid "Copy"
msgstr "副本"

msgid "Custom address"
msgstr "自定义地址"

msgid "Delete"
msgstr "删除"

msgid "Delete connection?"
msgstr "删除此连接？"

msgid "Delete this profile and stop its listeners? Relays in use cannot be deleted."
msgstr "删除此配置并停止其代理入口？正在被使用的中转节点不能删除。"

msgid "Direct connection"
msgstr "直连"

msgid "Connection disabled"
msgstr "连接已停用"

msgid "Duplicate"
msgstr "复制连接"

msgid "Edit"
msgstr "编辑"

msgid "Edit connection"
msgstr "编辑连接"

msgid "Enable this connection"
msgstr "启用此连接"

msgid "Enable connection"
msgstr "启用连接"

msgid "Export"
msgstr "导出"

msgid "Failed"
msgstr "失败"

msgid "Fill in the highlighted field."
msgstr "请填写标记的字段。"

msgid "Google HTTPS"
msgstr "Google HTTPS"

msgid "Import"
msgstr "导入"

msgid "Import a proxy client configuration."
msgstr "请导入代理客户端配置。"

msgid "Import the relay first, or choose a direct client configuration."
msgstr "请先导入关联的中转配置，或选择直连客户端配置。"

msgid "Invalid JSON."
msgstr "JSON 格式错误。"

msgid "LAN"
msgstr "局域网"

msgid "Leave empty to use system certificate authorities."
msgstr "留空则使用系统信任的证书。"

msgid "Listening IP"
msgstr "监听 IP"

msgid "Local proxy listeners"
msgstr "本地代理入口"

msgid "More"
msgstr "更多"

msgid "Name"
msgstr "名称"

msgid "No proxy listeners"
msgstr "未开启代理入口"

msgid "No relays configured. Direct connections do not need one."
msgstr "尚未配置中转节点，直连无需中转。"

msgid "Not tested"
msgstr "未测试"

msgid "Only this connection and its proxy listeners will stop."
msgstr "仅停止此连接及其代理入口。"

msgid "Port"
msgstr "端口"

msgid "Protocol"
msgstr "协议"

msgid "Proxy started"
msgstr "代理已启动"

msgid "REALITY public key"
msgstr "REALITY 公钥"

msgid "Relay profile"
msgstr "中转配置"

msgid "Relays"
msgstr "中转节点"

msgid "Remove"
msgstr "移除"

msgid "SOCKS5 and HTTP may share a port or use separate listeners."
msgstr "SOCKS5 和 HTTP 可以共用端口，也可以分别开启。"

msgid "Save and apply"
msgstr "保存并应用"

msgid "Save only"
msgstr "仅保存"

msgid "Saved changes are waiting to be applied."
msgstr "已保存的更改尚未应用。"

msgid "Server address"
msgstr "服务器地址"

msgid "Server name (SNI)"
msgstr "服务器名称（SNI）"

msgid "Server port"
msgstr "服务器端口"

msgid "Servers, connection paths and local proxy listeners."
msgstr "管理对端服务器、连接路径和本地代理入口。"

msgid "Shared relay settings. Test Google on a complete connection that uses this relay."
msgstr "公共中转配置。请在使用它的完整连接上测试 Google。"

msgid "Short ID"
msgstr "短 ID"

msgid "Show secret"
msgstr "显示密钥"

msgid "Start failed"
msgstr "启动失败"

msgid "Stop"
msgstr "停止"

msgid "Stop connection?"
msgstr "停止此连接？"

msgid "Test Google"
msgstr "测试 Google"

msgid "Test Google sends an HTTPS request through the selected connection. Time includes any required tunnel setup and TLS handshake; it is not ping RTT."
msgstr "测试 Google 会通过所选连接发送 HTTPS 请求。耗时包含必要的隧道建立和 TLS 握手，不是 ping 往返延迟。"

msgid "Testing…"
msgstr "测试中…"

msgid "This router only"
msgstr "仅路由器本机"

msgid "Transport"
msgstr "传输方式"

msgid "Via"
msgstr "经过"

msgid "Unsupported connection bundle version."
msgstr "不支持此连接包版本。"

msgid "Invalid embedded relay."
msgstr "内嵌中转配置无效。"
