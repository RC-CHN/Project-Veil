// Veil: bounded cache of ciphertext batches. Only current Write data is batched.
const veilBatchBytes = 8 * (maxPlaintext + recordHeaderLen + 256)

var veilBatchPool = make(chan []byte, 16)

func (c *Conn) veilWriteApplicationBatchLocked(data []byte) (int, error) {
	var b []byte
	select {
	case b = <-veilBatchPool:
	default:
		b = make([]byte, 0, veilBatchBytes)
	}
	defer func() {
		select {
		case veilBatchPool <- b[:0]:
		default:
		}
	}()
	n, pending := 0, 0
	flush := func() error {
		if len(b) == 0 {
			return nil
		}
		written, err := c.write(b)
		if err != nil {
			return err
		}
		if written != len(b) {
			return io.ErrShortWrite
		}
		n += pending
		pending = 0
		b = b[:0]
		return nil
	}
	for len(data) > 0 {
		m := len(data)
		if m > maxPlaintext {
			m = maxPlaintext
		}
		if len(b)+m+recordHeaderLen+256 > cap(b) {
			if err := flush(); err != nil {
				return n, err
			}
		}
		start := len(b)
		b = b[:start+recordHeaderLen]
		record := b[start:]
		record[0] = byte(recordTypeApplicationData)
		record[1], record[2] = 3, 3
		record[3], record[4] = byte(m>>8), byte(m)
		var err error
		record, err = c.out.encrypt(record, data[:m], c.config.rand())
		if err != nil {
			return n, err
		}
		if &record[0] != &b[start] {
			return n, errors.New("tls: Veil batch reserve exhausted")
		}
		b = b[:start+len(record)]
		pending += m
		data = data[m:]
	}
	err := flush()
	return n, err
}

var errVeilNeedRecord = errors.New("tls: Veil drain requires more ciphertext")

func (c *Conn) veilDrainBufferedRecords(b []byte, n int) (int, error) {
	c.veilDraining = true
	defer func() { c.veilDraining = false }()
	for count := 0; count < 8 && n < len(b) && c.input.Len() == 0 && c.hand.Len() == 0 && c.rawInput.Len() >= recordHeaderLen; count++ {
		err := c.readRecord()
		if err == errVeilNeedRecord {
			break
		}
		if err != nil {
			return n, err
		}
		for c.hand.Len() > 0 {
			h := c.hand.Bytes()
			if len(h) < 4 {
				return n, nil
			}
			length := int(h[1])<<16 | int(h[2])<<8 | int(h[3])
			if len(h) < 4+length {
				return n, nil
			}
			if err := c.handlePostHandshakeMessage(); err != nil {
				return n, err
			}
		}
		m, _ := c.input.Read(b[n:])
		n += m
	}
	return n, nil
}

// Called only between streams, with no application Read/Write in flight.
// Never discard read-ahead data that belongs to the next control message.
func (c *Conn) VeilReleaseBuffers() {
	c.in.Lock()
	defer c.in.Unlock()
	if c.input.Len() == 0 && c.rawInput.Len() == 0 && c.hand.Len() == 0 {
		c.input.Reset(nil)
		c.rawInput = bytes.Buffer{}
		c.hand = bytes.Buffer{}
	}
}

// EVP resources are also released on traffic-key replacement, not only at GC.
func veilReleaseAEAD(v any) {
	if x, ok := v.(*xorNonceAEAD); ok {
		if closer, ok := x.aead.(interface{ Close() error }); ok {
			closer.Close()
		}
	}
}
func (c *Conn) veilReleaseCrypto() {
	c.handshakeMutex.Lock()
	defer c.handshakeMutex.Unlock()
	c.in.Lock()
	defer c.in.Unlock()
	c.out.Lock()
	defer c.out.Unlock()
	veilReleaseAEAD(c.in.cipher)
	veilReleaseAEAD(c.out.cipher)
}
