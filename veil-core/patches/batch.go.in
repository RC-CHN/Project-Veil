// Batch only the current Write; never wait for future plaintext.
func (c *Conn) veilWriteApplicationBatchLocked(data []byte) (int, error) {
	b := veilTakeBuffer()
	defer func() {
		veilPutBuffer(b)
	}()
	n, pending := 0, 0
	flush := func() error {
		if len(b) == 0 {
			return nil
		}
		written, err := c.write(b)
		if err != nil {
			return err
		}
		if written != len(b) {
			return io.ErrShortWrite
		}
		n += pending
		pending = 0
		b = b[:0]
		return nil
	}
	for len(data) > 0 {
		m := len(data)
		if m > maxPlaintext {
			m = maxPlaintext
		}
		if len(b)+m+recordHeaderLen+256 > veilBatchBytes {
			if err := flush(); err != nil {
				return n, err
			}
		}
		start := len(b)
		b = b[:start+recordHeaderLen]
		record := b[start:]
		record[0] = byte(recordTypeApplicationData)
		record[1], record[2] = 3, 3
		record[3], record[4] = byte(m>>8), byte(m)
		var err error
		record, err = c.out.encrypt(record, data[:m], c.config.rand())
		if err != nil {
			return n, err
		}
		if &record[0] != &b[start] {
			return n, errors.New("tls: Veil batch reserve exhausted")
		}
		b = b[:start+len(record)]
		pending += m
		data = data[m:]
	}
	err := flush()
	return n, err
}

// EVP resources are also released on traffic-key replacement, not only at GC.
func veilReleaseAEAD(v any) {
	if x, ok := v.(*xorNonceAEAD); ok {
		if closer, ok := x.aead.(interface{ Close() error }); ok {
			closer.Close()
		}
	}
}
func (c *Conn) veilReleaseCrypto() {
	c.handshakeMutex.Lock()
	defer c.handshakeMutex.Unlock()
	c.in.Lock()
	defer c.in.Unlock()
	c.out.Lock()
	defer c.out.Unlock()
	veilReleaseAEAD(c.in.cipher)
	veilReleaseAEAD(c.out.cipher)
}
