package tls

import (
	"bytes"
	"io"
	"testing"
)

func TestVeilUConnReadAfterClose(t *testing.T) {
	veilCheckReadAfterClose(t, func(c *Conn) io.Reader { return &UConn{Conn: c} })
}

func TestVeilUConnCloseDuringBufferedRead(t *testing.T) {
	veilCheckCloseDuringBufferedRead(t, func(c *Conn) io.Reader { return &UConn{Conn: c} })
}

func TestVeilUConnDrain(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	plain := bytes.Repeat([]byte{47}, 8*maxPlaintext)
	w.Write(plain)
	w.writeRecordLocked(recordTypeHandshake, []byte{24, 0, 0, 1, 1})
	rr := new(veilMemoryConn)
	rr.input.Write(raw.output.Bytes())
	r := veilTestConn(rr)
	r.isClient = true
	defer r.veilReleaseCrypto()
	u := &UConn{Conn: r}
	b := make([]byte, len(plain)+1)
	n, err := u.Read(b)
	if err != nil || n != 3*maxPlaintext || rr.reads != 2 {
		t.Fatal("UConn did not drain complete buffered records", n, err, rr.reads)
	}
	for n < len(plain) {
		m, err := u.Read(b[n:])
		if err != nil || m == 0 {
			t.Fatal("UConn batch read", m, err)
		}
		n += m
	}
	if n != len(plain) || !bytes.Equal(b[:n], plain) {
		t.Fatal("UConn changed plaintext")
	}
	// The final read drains the buffered KeyUpdate after the application data.
	if rr.reads != 4 {
		t.Fatal("unexpected ciphertext reads", rr.reads)
	}
	if bytes.Equal(r.in.trafficSecret, make([]byte, 32)) || rr.writes != 1 {
		t.Fatal("UConn lost KeyUpdate")
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Cap() != 0 {
		t.Fatal("idle UConn retained buffer")
	}
}
