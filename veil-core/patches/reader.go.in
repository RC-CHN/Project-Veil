// Bounded TLS read batches include record overhead, not just plaintext bytes.
const veilBatchBytes = 8 * (maxPlaintext + recordHeaderLen + 256)

// Reserve space for encryption overhead when batching application writes.
const veilBufferBytes = 2 * veilBatchBytes

// Each cache is bounded independently of the number of live connections.
var veilBatchPool = make(chan []byte, 8)

func veilTakeBuffer() []byte {
	select {
	case b := <-veilBatchPool:
		return b[:0]
	default:
		return make([]byte, 0, veilBufferBytes)
	}
}

func veilPutBuffer(b []byte) {
	if cap(b) != veilBufferBytes {
		return
	}
	select {
	case veilBatchPool <- b[:0]:
	default:
	}
}

// Read buffers remain owned by a connection, unlike write batches. Keep their
// bound smaller so many multiplexed connections do not pin large write-sized
// buffers. Reads never wait to fill the buffer.
const veilReadBufferBytes = 64 << 10
var veilReadPool = make(chan []byte, 8)

func veilTakeReadBuffer() []byte {
	select {
	case b := <-veilReadPool:
		return b[:0]
	default:
		return make([]byte, 0, veilReadBufferBytes)
	}
}

func veilPutReadBuffer(b []byte) {
	if cap(b) != veilReadBufferBytes {
		return
	}
	select {
	case veilReadPool <- b[:0]:
	default:
	}
}

// Short connections start small and promote on their first larger record.
const veilSmallReadBytes = 4096

// Read directly without allocating LimitedReader or atLeastReader wrappers.
func (c *Conn) veilReadFromUntil(r io.Reader, n int) error {
	pending := c.rawInput.Bytes()
	if c.rawInput.Cap() < veilSmallReadBytes || c.rawInput.Cap() < n {
		if n <= veilSmallReadBytes {
			c.rawInput = *bytes.NewBuffer(make([]byte, 0, veilSmallReadBytes))
		} else {
			c.rawInput = *bytes.NewBuffer(veilTakeReadBuffer())
		}
	} else {
		c.rawInput.Reset()
	}
	c.rawInput.Write(pending)
	for c.rawInput.Len() < n {
		available := c.rawInput.AvailableBuffer()
		got, err := r.Read(available[:cap(available)])
		c.rawInput.Write(available[:got])
		if err != nil {
			if err == io.EOF {
				if c.rawInput.Len() < n {
					return io.ErrUnexpectedEOF
				}
				return nil
			}
			return err
		}
		if got == 0 {
			return io.ErrNoProgress
		}
	}
	return nil
}

var errVeilNeedRecord = errors.New("tls: Veil drain requires more ciphertext")

func (c *Conn) veilDrainBufferedRecords(b []byte, n int, postHandshake func() error) (int, error) {
	c.veilDraining = true
	defer func() { c.veilDraining = false }()
	for count := 0; count < 8 && n < len(b) && c.input.Len() == 0 && c.hand.Len() == 0 && c.rawInput.Len() >= recordHeaderLen; count++ {
		err := c.readRecord()
		if err == errVeilNeedRecord {
			break
		}
		if err != nil {
			return n, err
		}
		for c.hand.Len() > 0 {
			h := c.hand.Bytes()
			if len(h) < 4 {
				return n, nil
			}
			length := int(h[1])<<16 | int(h[2])<<8 | int(h[3])
			if len(h) < 4+length {
				return n, nil
			}
			if err := postHandshake(); err != nil {
				return n, err
			}
		}
		m, _ := c.input.Read(b[n:])
		n += m
	}
	return n, nil
}

// Called only between streams, with no application Read/Write in flight.
// Never discard read-ahead data that belongs to the next control message.
func (c *Conn) VeilReleaseBuffers() {
	c.in.Lock()
	defer c.in.Unlock()
	if c.input.Len() == 0 && c.rawInput.Len() == 0 && c.hand.Len() == 0 {
		c.input.Reset(nil)
		c.rawInput.Reset()
		veilPutReadBuffer(c.rawInput.Bytes())
		c.rawInput = bytes.Buffer{}
		c.hand = bytes.Buffer{}
	}
}
