// Bounded TLS read batches include record overhead, not just plaintext bytes.
const veilBatchBytes = 8 * (maxPlaintext + recordHeaderLen + 256)

// Two batches amortize socket reads without waiting to fill the buffer. The
// writer still flushes at veilBatchBytes; the shared cache stays about 2 MiB.
const veilBufferBytes = 2 * veilBatchBytes

// Read and write batches share one bounded cache. Buffers are returned only
// after all views are empty; an idle connection owns none of these batches.
var veilBatchPool = make(chan []byte, 8)

func veilTakeBuffer() []byte {
	select {
	case b := <-veilBatchPool:
		return b[:0]
	default:
		return make([]byte, 0, veilBufferBytes)
	}
}

func veilPutBuffer(b []byte) {
	if cap(b) != veilBufferBytes {
		return
	}
	select {
	case veilBatchPool <- b[:0]:
	default:
	}
}

var errVeilNeedRecord = errors.New("tls: Veil drain requires more ciphertext")

func (c *Conn) veilDrainBufferedRecords(b []byte, n int, postHandshake func() error) (int, error) {
	c.veilDraining = true
	defer func() { c.veilDraining = false }()
	for count := 0; count < 8 && n < len(b) && c.input.Len() == 0 && c.hand.Len() == 0 && c.rawInput.Len() >= recordHeaderLen; count++ {
		err := c.readRecord()
		if err == errVeilNeedRecord {
			break
		}
		if err != nil {
			return n, err
		}
		for c.hand.Len() > 0 {
			h := c.hand.Bytes()
			if len(h) < 4 {
				return n, nil
			}
			length := int(h[1])<<16 | int(h[2])<<8 | int(h[3])
			if len(h) < 4+length {
				return n, nil
			}
			if err := postHandshake(); err != nil {
				return n, err
			}
		}
		m, _ := c.input.Read(b[n:])
		n += m
	}
	return n, nil
}

// Called only between streams, with no application Read/Write in flight.
// Never discard read-ahead data that belongs to the next control message.
func (c *Conn) VeilReleaseBuffers() {
	c.in.Lock()
	defer c.in.Unlock()
	if c.input.Len() == 0 && c.rawInput.Len() == 0 && c.hand.Len() == 0 {
		c.input.Reset(nil)
		c.rawInput.Reset()
		veilPutBuffer(c.rawInput.Bytes())
		c.rawInput = bytes.Buffer{}
		c.hand = bytes.Buffer{}
	}
}
