package tls

import (
	"bytes"
	"crypto/cipher"
	"errors"
	"io"
	"net"
	"os"
	"sync"
	"testing"
	"time"
)

type veilMemoryConn struct {
	input, output bytes.Buffer
	reads, writes int
	fail          error
	readErr       error
}

func (c *veilMemoryConn) Read(p []byte) (int, error) {
	c.reads++
	if c.input.Len() == 0 {
		if c.readErr != nil {
			return 0, c.readErr
		}
		return 0, io.ErrNoProgress
	}
	return c.input.Read(p)
}

func TestVeilPartialRecordTimeoutAndBufferRelease(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	plain := bytes.Repeat([]byte{71}, 2*maxPlaintext)
	w.Write(plain)
	ciphertext := append([]byte(nil), raw.output.Bytes()...)
	rr := &veilMemoryConn{readErr: os.ErrDeadlineExceeded}
	rr.input.Write(ciphertext[:len(ciphertext)-7])
	r := veilTestConn(rr)
	defer r.veilReleaseCrypto()
	b := make([]byte, len(plain))
	n, err := r.Read(b)
	if err != nil || n != maxPlaintext {
		t.Fatal(n, err)
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Len() == 0 {
		t.Fatal("discarded partial next record")
	}
	if _, err := r.Read(b[n:]); !errors.Is(err, os.ErrDeadlineExceeded) || r.in.err != nil {
		t.Fatal("temporary read poisoned TLS", err, r.in.err)
	}
	rr.input.Write(ciphertext[len(ciphertext)-7:])
	if _, err := io.ReadFull(r, b[n:]); err != nil || !bytes.Equal(b, plain) {
		t.Fatal("timeout resume changed plaintext", err)
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Cap() != 0 {
		t.Fatal("idle buffer retained")
	}
}
func (c *veilMemoryConn) Write(p []byte) (int, error) {
	c.writes++
	if c.fail != nil {
		return 0, c.fail
	}
	return c.output.Write(p)
}
func (c *veilMemoryConn) Close() error                     { return nil }
func (c *veilMemoryConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
func (c *veilMemoryConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
func (c *veilMemoryConn) SetDeadline(time.Time) error      { return nil }
func (c *veilMemoryConn) SetReadDeadline(time.Time) error  { return nil }
func (c *veilMemoryConn) SetWriteDeadline(time.Time) error { return nil }
func veilTestConn(raw *veilMemoryConn) *Conn {
	c := &Conn{conn: raw, config: &Config{}, vers: VersionTLS13, haveVers: true, cipherSuite: TLS_AES_128_GCM_SHA256, bytesSent: recordSizeBoostThreshold}
	c.isHandshakeComplete.Store(true)
	c.in.version = VersionTLS13
	c.out.version = VersionTLS13
	c.in.cipher = aeadAESGCMTLS13(make([]byte, 16), make([]byte, 12))
	c.out.cipher = aeadAESGCMTLS13(make([]byte, 16), make([]byte, 12))
	c.in.trafficSecret = make([]byte, 32)
	c.out.trafficSecret = make([]byte, 32)
	return c
}
func TestVeilBatchAndDrain(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	plain := bytes.Repeat([]byte{31}, 16*maxPlaintext)
	if n, e := w.Write(plain); e != nil || n != len(plain) {
		t.Fatalf("write %d %v", n, e)
	}
	if raw.writes != 2 {
		t.Fatalf("writes %d", raw.writes)
	}
	rr := &veilMemoryConn{}
	rr.input.Write(raw.output.Bytes())
	r := veilTestConn(rr)
	defer r.veilReleaseCrypto()
	out := make([]byte, len(plain))
	n, err := r.Read(out)
	if err != nil || n != 3*maxPlaintext {
		t.Fatalf("complete buffered records: %d %v", n, err)
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Len() == 0 {
		t.Fatal("released the partial next record")
	}
	if _, err := io.ReadFull(r, out[n:]); err != nil || !bytes.Equal(out, plain) {
		t.Fatal("read batches changed plaintext", err)
	}
	// Each fill can carry three complete records plus a partial fourth.
	if rr.reads != 7 {
		t.Fatalf("extra read: %d", rr.reads)
	}
	if r.rawInput.Cap() > veilReadBufferBytes {
		t.Fatalf("unbounded input buffer %d", r.rawInput.Cap())
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Cap() != 0 {
		t.Fatal("idle buffer retained")
	}
}
func TestVeilPartialAndBadTag(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	w.Write(bytes.Repeat([]byte{7}, maxPlaintext))
	first := append([]byte(nil), raw.output.Bytes()...)
	raw.output.Reset()
	w.Write([]byte{3})
	second := append([]byte(nil), raw.output.Bytes()...)
	for _, cut := range []int{1, 5, len(second) - 1} {
		rr := new(veilMemoryConn)
		rr.input.Write(first)
		rr.input.Write(second[:cut])
		r := veilTestConn(rr)
		b := make([]byte, 2*maxPlaintext)
		n, e := r.Read(b)
		if e != nil || n != maxPlaintext || rr.reads != 2 || r.in.err != nil {
			t.Fatalf("cut=%d n=%d reads=%d err=%v sticky=%v", cut, n, rr.reads, e, r.in.err)
		}
		rr.input.Write(second[cut:])
		n, e = r.Read(b)
		if e != nil || n != 1 || b[0] != 3 {
			t.Fatalf("resume n=%d err=%v", n, e)
		}
		r.veilReleaseCrypto()
	}
	rr := new(veilMemoryConn)
	bad := append([]byte(nil), first...)
	bad[len(bad)-1] ^= 1
	rr.input.Write(bad)
	r := veilTestConn(rr)
	defer r.veilReleaseCrypto()
	if _, e := r.Read(make([]byte, 2*maxPlaintext)); e == nil {
		t.Fatal("bad tag accepted")
	}
	sticky := r.in.err
	if _, e := r.Read(make([]byte, 1)); e != sticky {
		t.Fatal("read error not sticky")
	}
}
func TestVeilBufferedKeyUpdate(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	w.Write(bytes.Repeat([]byte{9}, maxPlaintext))
	w.writeRecordLocked(recordTypeHandshake, []byte{24, 0, 0, 1, 1})
	rr := new(veilMemoryConn)
	rr.input.Write(raw.output.Bytes())
	r := veilTestConn(rr)
	defer r.veilReleaseCrypto()
	n, e := r.Read(make([]byte, 2*maxPlaintext))
	if e != nil || n != maxPlaintext {
		t.Fatalf("%d %v", n, e)
	}
	if bytes.Equal(r.in.trafficSecret, make([]byte, 32)) || rr.writes != 1 || r.hand.Len() != 0 {
		t.Fatal("complete KeyUpdate deferred past Read")
	}
}
func TestVeilWriteFailure(t *testing.T) {
	raw := &veilMemoryConn{fail: errors.New("injected")}
	c := veilTestConn(raw)
	defer c.veilReleaseCrypto()
	if _, e := c.Write(make([]byte, 2*maxPlaintext)); e == nil {
		t.Fatal("failure lost")
	}
	n := raw.writes
	if _, e := c.Write([]byte{1}); e == nil || raw.writes != n {
		t.Fatal("write error not sticky")
	}
}

// A repeated Close must not release keys while the first Close is still
// preparing close_notify. Only the goroutine winning activeCall owns teardown.
func TestVeilRepeatedClose(t *testing.T) {
	c := veilTestConn(new(veilMemoryConn))
	c.activeCall.Store(1)
	c.in.Lock()
	done := make(chan error, 1)
	go func() { done <- c.Close() }()
	select {
	case err := <-done:
		if err != net.ErrClosed {
			t.Errorf("unexpected %v", err)
		}
	case <-time.After(time.Second):
		c.in.Unlock()
		<-done
		c.veilReleaseCrypto()
		t.Fatal("repeated Close tried to tear down the owner's crypto")
	}
	c.in.Unlock()
	c.veilReleaseCrypto()
}

// A completed Close owns and releases both traffic keys. Buffered ciphertext
// must not let a later Read enter decrypt or send an alert with released keys.
func TestVeilReadAfterClose(t *testing.T) {
	veilCheckReadAfterClose(t, func(c *Conn) io.Reader { return c })
}

func veilCheckReadAfterClose(t *testing.T, reader func(*Conn) io.Reader) {
	t.Helper()
	unhandshaken := veilTestConn(new(veilMemoryConn))
	unhandshaken.isHandshakeComplete.Store(false)
	if err := unhandshaken.Close(); err != nil {
		t.Fatal(err)
	}
	if n, err := reader(unhandshaken).Read(make([]byte, 1)); n != 0 || !errors.Is(err, net.ErrClosed) {
		t.Fatalf("post-close handshake: %d, %v", n, err)
	}
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	plain := bytes.Repeat([]byte{37}, 2*maxPlaintext)
	if _, err := w.Write(plain); err != nil {
		t.Fatal(err)
	}
	rr := new(veilMemoryConn)
	rr.input.Write(raw.output.Bytes())
	r := veilTestConn(rr)
	read := reader(r)
	if _, err := read.Read(make([]byte, 1)); err != nil {
		t.Fatal(err)
	}
	if r.rawInput.Len() == 0 || r.input.Len() == 0 {
		t.Fatal("test needs both buffered plaintext and ciphertext")
	}
	if err := r.Close(); err != nil {
		t.Fatal(err)
	}
	if n, err := read.Read(make([]byte, len(plain))); n != 0 || !errors.Is(err, net.ErrClosed) {
		t.Fatalf("post-close read: %d, %v", n, err)
	}
	// A pending post-handshake message skips readRecord's usual error guard.
	r.input.Reset(nil)
	r.hand.Write([]byte{24, 0, 0, 1, 1})
	secret := append([]byte(nil), r.in.trafficSecret...)
	if n, err := read.Read(make([]byte, 1)); n != 0 || !errors.Is(err, net.ErrClosed) {
		t.Fatalf("post-close key update: %d, %v", n, err)
	}
	if !bytes.Equal(secret, r.in.trafficSecret) {
		t.Fatal("post-close read replaced traffic keys")
	}
	writes := rr.writes
	if err := r.sendAlert(alertInternalError); err == nil || rr.writes != writes {
		t.Fatal("post-close alert wrote to the wire", err, rr.writes)
	}
	if _, err := r.Write([]byte{1}); !errors.Is(err, net.ErrClosed) {
		t.Fatal("post-close Write", err)
	}
}

type veilBlockingAEAD struct {
	cipher.AEAD
	entered, resume chan struct{}
	once            sync.Once
}

func (a *veilBlockingAEAD) Open(dst, nonce, ciphertext, additional []byte) ([]byte, error) {
	a.once.Do(func() { close(a.entered); <-a.resume })
	return a.AEAD.Open(dst, nonce, ciphertext, additional)
}

func (a *veilBlockingAEAD) Close() error {
	if closer, ok := a.AEAD.(interface{ Close() error }); ok {
		return closer.Close()
	}
	return nil
}

type veilObservedCloseConn struct {
	net.Conn
	closed chan struct{}
}

func (c *veilObservedCloseConn) Close() error {
	close(c.closed)
	return c.Conn.Close()
}

func TestVeilCloseDuringBufferedRead(t *testing.T) {
	veilCheckCloseDuringBufferedRead(t, func(c *Conn) io.Reader { return c })
}

func veilCheckCloseDuringBufferedRead(t *testing.T, reader func(*Conn) io.Reader) {
	t.Helper()
	for _, corrupt := range []bool{false, true} {
		raw := new(veilMemoryConn)
		w := veilTestConn(raw)
		plain := bytes.Repeat([]byte{53}, 2*maxPlaintext)
		if _, err := w.Write(plain); err != nil {
			t.Fatal(err)
		}
		w.veilReleaseCrypto()
		if corrupt {
			raw.output.Bytes()[recordHeaderLen+maxPlaintext] ^= 1
		}
		r := veilTestConn(new(veilMemoryConn))
		rawClose := &veilObservedCloseConn{Conn: r.conn, closed: make(chan struct{})}
		r.conn = rawClose
		r.rawInput.Write(raw.output.Bytes())
		x := r.in.cipher.(*xorNonceAEAD)
		block := &veilBlockingAEAD{AEAD: x.aead, entered: make(chan struct{}), resume: make(chan struct{})}
		x.aead = block
		read := reader(r)
		readDone := make(chan error, 1)
		go func() {
			got := make([]byte, len(plain))
			n, err := read.Read(got)
			if !corrupt && (n != len(plain) || !bytes.Equal(got, plain)) {
				err = errors.New("concurrent Close changed buffered plaintext")
			}
			readDone <- err
		}()
		<-block.entered
		closeDone := make(chan error, 1)
		go func() { closeDone <- r.Close() }()
		<-rawClose.closed
		// Close must wait until the reader gives up ownership of the key.
		select {
		case err := <-closeDone:
			close(block.resume)
			t.Fatal("Close released a key in use", err)
		default:
		}
		close(block.resume)
		if err := <-readDone; (err != nil) != corrupt {
			t.Fatal("read error", err)
		}
		<-closeDone
		if n, err := read.Read(make([]byte, 1)); n != 0 || !errors.Is(err, net.ErrClosed) {
			t.Fatalf("post-concurrent-close read: %d, %v", n, err)
		}
	}
}

type veilFinalReader struct {
	payload []byte
	err     error
}

func (r veilFinalReader) Read(p []byte) (int, error) { return copy(p, r.payload), r.err }

// A Reader may deliver its final bytes and an error together. Preserve both
// TLS truncation detection and buffered bytes across temporary read failures.
func TestVeilReadFinalBytesAndError(t *testing.T) {
	for _, tc := range []struct {
		name      string
		bytes     int
		err, want error
	}{
		{"complete EOF", 5, io.EOF, nil},
		{"truncated EOF", 3, io.EOF, io.ErrUnexpectedEOF},
		{"complete timeout", 5, os.ErrDeadlineExceeded, os.ErrDeadlineExceeded},
		{"partial timeout", 3, os.ErrDeadlineExceeded, os.ErrDeadlineExceeded},
		{"empty read", 0, nil, io.ErrNoProgress},
	} {
		t.Run(tc.name, func(t *testing.T) {
			c := veilTestConn(new(veilMemoryConn))
			defer c.veilReleaseCrypto()
			p := bytes.Repeat([]byte{71}, tc.bytes)
			err := c.readFromUntil(veilFinalReader{p, tc.err}, 5)
			if !errors.Is(err, tc.want) || !bytes.Equal(c.rawInput.Bytes(), p) {
				t.Fatalf("read %x, error %v; want %x, %v", c.rawInput.Bytes(), err, p, tc.want)
			}
			if tc.bytes == 5 {
				if err := c.readFromUntil(bytes.NewReader(nil), 5); err != nil {
					t.Fatal("lost buffered bytes", err)
				}
			}
		})
	}
}

// A short connection keeps a small receive buffer. Its first large record
// promotes once, retaining the original batching bound and byte semantics.
func TestVeilAdaptiveReadBuffer(t *testing.T) {
	raw := new(veilMemoryConn)
	w := veilTestConn(raw)
	defer w.veilReleaseCrypto()
	rr := new(veilMemoryConn)
	r := veilTestConn(rr)
	defer r.veilReleaseCrypto()
	promoted := false
	for _, size := range []int{1, 64, 2048, maxPlaintext, 64, 2 * maxPlaintext} {
		p := bytes.Repeat([]byte{byte(size + 1)}, size)
		raw.output.Reset()
		if _, err := w.Write(p); err != nil {
			t.Fatal(err)
		}
		rr.input.Write(raw.output.Bytes())
		got := make([]byte, len(p))
		if _, err := io.ReadFull(r, got); err != nil || !bytes.Equal(got, p) {
			t.Fatalf("size %d: %v", size, err)
		}
		promoted = promoted || size >= maxPlaintext
		want := veilSmallReadBytes
		if promoted {
			want = veilReadBufferBytes
		}
		if r.rawInput.Cap() != want {
			t.Fatalf("size %d: capacity %d want %d", size, r.rawInput.Cap(), want)
		}
	}
}
