package tls

import (
	"bytes"
	"encoding/binary"
	"io"
	"net"
	"testing"
	"time"
)

type veilPaddingMemory struct{ bytes.Buffer }

func (*veilPaddingMemory) Close() error                     { return nil }
func (*veilPaddingMemory) LocalAddr() net.Addr              { return &net.TCPAddr{} }
func (*veilPaddingMemory) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
func (*veilPaddingMemory) SetDeadline(time.Time) error      { return nil }
func (*veilPaddingMemory) SetReadDeadline(time.Time) error  { return nil }
func (*veilPaddingMemory) SetWriteDeadline(time.Time) error { return nil }

func veilPaddingConn(raw *veilPaddingMemory) *Conn {
	c := &Conn{conn: raw, config: &Config{}, vers: VersionTLS13, haveVers: true,
		cipherSuite: TLS_AES_128_GCM_SHA256, bytesSent: recordSizeBoostThreshold}
	c.isHandshakeComplete.Store(true)
	c.in.version, c.out.version = VersionTLS13, VersionTLS13
	c.in.cipher = aeadAESGCMTLS13(make([]byte, 16), make([]byte, 12))
	c.out.cipher = aeadAESGCMTLS13(make([]byte, 16), make([]byte, 12))
	return c
}

func TestVeilPaddingBudgetAndIntegrity(t *testing.T) {
	raw := new(veilPaddingMemory)
	w := veilPaddingConn(raw)
	defer w.Close()
	w.VeilSetPaddingBudget(256, 6, 1024)
	if n, err := w.Write(nil); n != 0 || err != nil || raw.Len() != 0 {
		t.Fatal("empty write emitted a record", n, err)
	}
	var plain []byte
	limit := uint16(256)
	for stream := 0; stream < 64; stream++ {
		count := uint8(stream%12 + 1)
		budget := 64 + stream*61
		if err := w.VeilSetPaddingBudget(int(limit), int(count), budget); err != nil {
			t.Fatal(err)
		}
		added := 0
		for i, size := range []int{64, 128, 513, maxPlaintext, 7, 4096, 32, 16, 100, 100, 256, 512, 1024} {
			p := bytes.Repeat([]byte{byte(i + 1)}, size)
			p[len(p)-1], p[len(p)-2] = 0, 0 // content zeros must not be stripped
			plain = append(plain, p...)
			start := raw.Len()
			if n, err := w.Write(p); err != nil || n != len(p) {
				t.Fatal("write", n, err)
			}
			record := raw.Bytes()[start:]
			length := int(binary.BigEndian.Uint16(record[3:5]))
			if length+5 != len(record) || length > maxPlaintext+17 {
				t.Fatal("TLS record overflow or unexpected split", length)
			}
			extra := length - size - 17
			if i < int(count) && size < maxPlaintext && added < budget {
				if extra < 1 || extra > int(limit) {
					t.Fatal("padding outside budget", extra)
				}
			} else if extra != 0 {
				t.Fatal("padding after budget or at record limit", extra)
			}
			added += extra
		}
		if added > budget || w.out.veilPadRecords != 0 {
			t.Fatal("per-stream padding budget exceeded", added)
		}
	}
	w.VeilSetPaddingBudget(0, 0, 0)
	if w.out.veilPadRecords != 0 || w.out.veilPadBytes != 0 {
		t.Fatal("padding not disabled")
	}
	wire := append([]byte(nil), raw.Bytes()...)
	rr := &veilPaddingMemory{}
	rr.Write(wire)
	r := veilPaddingConn(rr)
	defer r.Close()
	got := make([]byte, len(plain))
	if _, err := io.ReadFull(r, got); err != nil || !bytes.Equal(got, plain) {
		t.Fatal("padding changed application bytes", err)
	}
	// Padding is authenticated along with the content.
	wire[6] ^= 1
	bad := &veilPaddingMemory{}
	bad.Write(wire)
	b := veilPaddingConn(bad)
	defer b.Close()
	if _, err := b.Read(make([]byte, 64)); err == nil {
		t.Fatal("corrupted padded record accepted")
	}
}

func TestVeilPaddingSkipsAlerts(t *testing.T) {
	raw := new(veilPaddingMemory)
	c := veilPaddingConn(raw)
	defer c.Close()
	c.VeilSetPaddingBudget(256, 6, 1024)
	count, budget := c.out.veilPadRecords, c.out.veilPadBytes
	if _, err := c.writeRecordLocked(recordTypeAlert, []byte{alertLevelWarning, byte(alertCloseNotify)}); err != nil {
		t.Fatal(err)
	}
	if raw.Len() != 5+2+17 || c.out.veilPadRecords != count || c.out.veilPadBytes != budget {
		t.Fatal("alert was padded")
	}
}

// ECDSA DER lengths can exceed a cover's CertificateVerify record by a byte.
// Keep the authenticated handshake intact; pad only when the cover is larger.
func TestVeilPaddingRealityCoverSize(t *testing.T) {
	payload := make([]byte, 80)
	payload[0], payload[3] = typeCertificateVerify, 76
	minimum := len(payload) + 5 + 1 + 16
	for _, cover := range []int{minimum - 1, minimum, minimum + 32} {
		raw := new(veilPaddingMemory)
		c := veilPaddingConn(raw)
		defer c.Close()
		c.out.handshakeLen[1], c.out.handshakeLen[4] = 1, uint16(cover)
		if _, err := c.writeRecordLocked(recordTypeHandshake, payload); err != nil {
			t.Fatal("cover rejected a valid TLS record", err)
		}
		want := minimum
		if cover > want {
			want = cover
		}
		if raw.Len() != want {
			t.Fatal("unexpected padded record length", raw.Len(), cover)
		}
		plain, typ, err := c.in.decrypt(raw.Bytes())
		if err != nil || typ != recordTypeHandshake || !bytes.Equal(plain, payload) {
			t.Fatal("cover sizing changed authenticated handshake", err)
		}
	}
}

// The portable backend must drain the same complete records as batch/OpenSSL.
func TestVeilPaddingReaderDrain(t *testing.T) {
	raw := new(veilPaddingMemory)
	w := veilPaddingConn(raw)
	defer w.Close()
	plain := bytes.Repeat([]byte{23}, 8*maxPlaintext)
	if _, err := w.Write(plain); err != nil {
		t.Fatal(err)
	}
	r := veilPaddingConn(raw)
	defer r.Close()
	u := &UConn{Conn: r}
	b := make([]byte, len(plain))
	if n, err := u.Read(b); err != nil || n != 3*maxPlaintext {
		t.Fatal("did not drain complete buffered records", n, err)
	} else if _, err := io.ReadFull(u, b[n:]); err != nil || !bytes.Equal(b, plain) {
		t.Fatal("incomplete UConn batch", err)
	}
	r.VeilReleaseBuffers()
	if r.rawInput.Cap() != 0 {
		t.Fatal("idle buffer retained")
	}
}

func TestVeilPaddingRejectUnsafeBudget(t *testing.T) {
	c := veilPaddingConn(new(veilPaddingMemory))
	defer c.Close()
	for _, v := range [][3]int{{-1, 1, 1}, {513, 1, 1}, {1, -1, 1}, {1, 13, 1}, {1, 1, -1}, {1, 1, 4097}} {
		if c.VeilSetPaddingBudget(v[0], v[1], v[2]) == nil {
			t.Fatal("unsafe budget accepted", v)
		}
	}
}

// Covers the portable backend as well as the optimized uTLS builds.
func TestVeilPaddingAdaptiveReadBuffer(t *testing.T) {
	raw := new(veilPaddingMemory)
	w, r := veilPaddingConn(raw), veilPaddingConn(raw)
	defer w.Close()
	defer r.Close()
	promoted := false
	for _, size := range []int{1, 64, 2048, maxPlaintext, 64, 2 * maxPlaintext} {
		p := bytes.Repeat([]byte{byte(size + 1)}, size)
		if _, err := w.Write(p); err != nil {
			t.Fatal(err)
		}
		got := make([]byte, len(p))
		if _, err := io.ReadFull(r, got); err != nil || !bytes.Equal(got, p) {
			t.Fatalf("size %d: %v", size, err)
		}
		promoted = promoted || size >= maxPlaintext
		want := veilSmallReadBytes
		if promoted {
			want = veilReadBufferBytes
		}
		if r.rawInput.Cap() != want {
			t.Fatalf("size %d: capacity %d want %d", size, r.rawInput.Cap(), want)
		}
	}
}
