package tls

import (
	"errors"
	"math/rand/v2"
)

// VeilSetPaddingBudget installs one sender's externally configured profile.
// The connection's sole writer calls this at a stream activation boundary.
func (c *Conn) VeilSetPaddingBudget(limit, records, budget int) error {
	if limit < 0 || limit > 512 || records < 0 || records > 12 || budget < 0 || budget > 4096 {
		return errors.New("TLS padding budget outside allowed range")
	}
	c.out.Lock()
	defer c.out.Unlock()
	c.out.veilPadRecords, c.out.veilPadBytes = 0, 0
	if c.vers == VersionTLS13 && c.isHandshakeComplete.Load() {
		c.out.veilPadLimit = uint16(limit)
		c.out.veilPadRecords = uint8(records)
		c.out.veilPadBytes = uint16(budget)
	}
	return nil
}

func (hc *halfConn) veilRecordPadding(n int) int {
	if hc.veilPadRecords == 0 {
		return 0
	}
	hc.veilPadRecords--
	limit := maxPlaintext - n
	if limit > int(hc.veilPadLimit) {
		limit = int(hc.veilPadLimit)
	}
	if limit > int(hc.veilPadBytes) {
		limit = int(hc.veilPadBytes)
	}
	if limit <= 0 {
		return 0
	}
	// Size selection is not cryptographic. TLS keys and nonces are unchanged.
	extra := 1 + rand.IntN(limit)
	hc.veilPadBytes -= uint16(extra)
	if hc.veilPadBytes == 0 {
		hc.veilPadRecords = 0
	}
	return extra
}
